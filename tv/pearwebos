#!/bin/sh
# pearwebos: the on-TV side of PearWebOS.
#
# Files under $DIR/files mirror LG Home's qml/ tree and are bind-mounted over
# the stock ones; nothing on the read-only system changes, and `off` (or a
# reboot with the hook removed) is stock LG Home again.
#
# LG Home is restored from snapshots with its QML already loaded, so mounting
# files changes nothing until Home cold starts:
#  - a relaunch restores the CRIU snapshot in $CKPT, which the app manager
#    retakes after a cold start with whatever is mounted then;
#  - a full boot restores LG's quick-start image, which holds stock Home.
# $STAMP records the Home process started with Pear in. If the Home running
# at boot is not that one, it came from LG's image and is rebuilt.
#
#   pearwebos on      mount, cold-start Home, check it came up
#   pearwebos off     unmount, cold-start stock Home, and stay off at boot
#   pearwebos boot    what the init.d hook runs
#   pearwebos status
#   pearwebos settings  the power-on settings chosen in setup
#   pearwebos unmount   before replacing the files (the installer)
#
# Two ways Pear stays off at boot, kept apart so status can say which:
#  - $OFF: you ran `off`. Only `on` clears it.
#  - $FAILED: Home died with Pear mounted. One line per failed boot; boot
#    tries again until $MAX_FAILS lines have piled up, so one slow boot
#    (other startup hooks, a busy TV) can't switch Pear off for good.
#    `on` or a good boot clears it.

DIR=/var/lib/pearwebos
APP=/usr/palm/applications/com.webos.app.home/qml
CKPT=/mnt/lg/cmn_data/checkpoint/com.webos.app.home
STAMP=$DIR/checkpoint.stamp
OFF=$DIR/disabled
FAILED=$DIR/failed
MAX_FAILS=3
LOG=$DIR/pearwebos.log
LS=$DIR/luna-send-n

# choices from `pear setup`
GUARD=1 BOOT_TO_HOME=1 QUICK_START=1 NO_UPDATE_PROMPT=1
[ -f "$DIR/pear.conf" ] && . "$DIR/pear.conf"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "$LOG" >&2
    tail -n 300 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
}

# relative paths of every Pear file
pear_files() { (cd "$DIR/files" && find . -type f | sed 's|^\./||'); }

mounted() { grep -q " $1 " /proc/mounts; }

mount_all() {
    for f in $(pear_files); do
        t=$APP/$f
        [ -f "$t" ] || { log "no stock file for $f; skipped"; continue; }
        mounted "$t" || mount --bind "$DIR/files/$f" "$t" || log "mount failed: $f"
    done
}

umount_all() {
    for f in $(pear_files); do
        t=$APP/$f
        while mounted "$t"; do umount "$t" || break; done
    done
}

home_pid() { ps -eo pid,args | grep '[/]usr/bin/com.webos.app.home' | awk '{print $1}' | head -1; }

# which Home this is: its pid (kept across CRIU restores) and the snapshot
pear_id() { echo "$(home_pid) $([ -d "$CKPT" ] && stat -c '%Y-%i' "$CKPT" 2>/dev/null)"; }

open_home() { $LS -n 1 luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' >/dev/null; }

guard() { [ "$GUARD" = 1 ] && "$DIR/homeguard" "$1"; }

# Throw away the snapshot and start Home from its files. Returns as soon as
# the new Home process exists (no fixed sleeps: every second here is a second
# of stock Home on screen). Non-zero if no Home came up within 10s.
cold_start() {
    rm -rf "$CKPT"
    pid=$(home_pid)
    if [ -n "$pid" ]; then
        kill "$pid"
        i=0
        while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do usleep 100000; i=$((i + 1)); done
    fi
    open_home
    i=0
    while [ -z "$(home_pid)" ] && [ $i -lt 100 ]; do usleep 100000; i=$((i + 1)); done
    [ -n "$(home_pid)" ]
}

# After cold_start: wait (up to $1 seconds, default 30) for the app manager to
# snapshot the new Home, let it finish writing, and check Home stayed up.
# Only the stamp needs this, so on boot it runs after Pear is already on
# screen.
#   0  Home is up and snapshotted
#   1  Home is gone: it died with Pear mounted
#   2  Home is up but no snapshot yet. Not a Pear failure: the app manager
#      snapshots late, or not at all, on a busy or low-memory TV.
wait_snapshot() {
    i=0
    while [ ! -d "$CKPT" ] && [ $i -lt "${1:-30}" ]; do sleep 1; i=$((i + 1)); done
    sleep 8
    [ -n "$(home_pid)" ] || return 1
    [ -d "$CKPT" ] || return 2
    return 0
}

# What else is going on, for the log when something goes wrong: free memory,
# and the screen-capture / ambient-light services known to share the TV.
context() {
    avail=$(awk '/^MemAvailable:/ {print int($2 / 1024) "MB"}' /proc/meminfo 2>/dev/null)
    others=$(ps -eo args | grep -i -e '[h]yperhdr' -e '[p]iccap' -e '[h]yperion' |
             awk '{print $1}' | sed 's|.*/||' | sort -u | tr '\n' ' ')
    echo "mem available ${avail:-?}; also running: ${others:-none}"
}

fail_count() { [ -f "$FAILED" ] && wc -l < "$FAILED" | tr -d ' ' || echo 0; }

# Home died with Pear mounted: back to stock, and note it for the next boot
give_up() {
    log "$1; back to stock ($(context))"
    "$DIR/homeguard" stop
    go_stock
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$FAILED"
}

# true when nothing but Live TV (or nothing) is in front
front_is_bare() {
    ids=$($LS -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{"extraInfo":true}' |
          grep -o '"appId":"[^"]*"' | grep -v -e '"appId":"com.webos.app.livetv"' -e '"appId":""')
    [ -z "$ids" ]
}

go_stock() {
    umount_all
    cold_start && wait_snapshot
    rm -f "$STAMP"
}

cmd_on() {
    rm -f "$OFF" "$FAILED"
    # remount: a replaced file is a new inode, and a mount keeps the old one
    umount_all
    mount_all
    if ! cold_start; then
        give_up "on: no Home came up with Pear"
        return 1
    fi
    wait_snapshot
    case $? in
        0) pear_id > "$STAMP"
           guard start
           log "on: Pear Home up (snapshot $(cat "$STAMP"))" ;;
        2) rm -f "$STAMP"
           guard start
           log "on: Pear Home up, but no snapshot yet ($(context)); the next boot rebuilds it" ;;
        *) give_up "on: Home did not stay up with Pear"
           return 1 ;;
    esac
}

cmd_off() {
    touch "$OFF"
    rm -f "$FAILED"
    "$DIR/homeguard" stop
    go_stock
    log "off: stock Home"
}

# the settings a TV needs to power on straight into Home
boot_settings() {
    [ "$BOOT_TO_HOME" = 1 ] &&
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"general","settings":{"powerOnScreen":"liveTv","welcomeFeature":"off","noSignalScreenSaver":"off","homeAutoLaunch":"on","homeAutoLaunchMode":"full"}}' >/dev/null
    # Quick Start+: power-off sleeps, so power-on resumes Pear instead of
    # booting LG's stock Home
    [ "$QUICK_START" = 1 ] &&
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"option","settings":{"quickStartMode":"on"}}' >/dev/null
    # no "new software, update now?" at power-on: an update can remove root
    [ "$NO_UPDATE_PROMPT" = 1 ] &&
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"support","settings":{"automaticUpdate":"off","softwareUpdateEnable":"false"}}' >/dev/null
    return 0
}

cmd_boot() {
    [ -f "$OFF" ] && { log "boot: off"; return 0; }
    if [ "$(fail_count)" -ge "$MAX_FAILS" ]; then
        log "boot: Home failed with Pear on the last $MAX_FAILS tries; staying stock. Run 'pear on' to try again."
        return 0
    fi
    # an older version marked a failed boot with $OFF itself; the log tells them
    # apart from a real `off`, and `pear on` clears either
    mount_all
    # Pear first, so the stock Home is on screen as briefly as possible
    if [ -f "$STAMP" ] && [ "$(pear_id)" = "$(cat "$STAMP")" ]; then
        log "boot: Home already carries Pear"
        guard start
        boot_settings
        return 0
    fi
    log "boot: Home is stock ($(pear_id)); rebuilding with Pear"
    # files were mounted just above, so no remount; Pear is on screen as soon
    # as cold_start returns, and homeguard starts watching right away
    if ! cold_start; then
        give_up "boot: no Home came up with Pear"
        boot_settings
        return 1
    fi
    guard start
    # bookkeeping, off the visible path. Boot is when other startup hooks
    # (HyperHDR, PicCap and the like) compete for the TV, so give the app
    # manager longer to snapshot than `on` does.
    wait_snapshot 90
    case $? in
        0) pear_id > "$STAMP"
           rm -f "$FAILED"
           log "boot: Pear Home up (snapshot $(cat "$STAMP"))" ;;
        2) rm -f "$STAMP" "$FAILED"
           log "boot: Pear Home up, but no snapshot after 90s ($(context)); keeping Pear, the next boot rebuilds it" ;;
        *) give_up "boot: Home did not stay up with Pear (try $(($(fail_count) + 1)) of $MAX_FAILS)"
           boot_settings
           return 1 ;;
    esac
    # Home is an overlay; if LG left only Live TV in front, bring Home up.
    # Don't yank the user out of an app they opened meanwhile.
    [ "$BOOT_TO_HOME" = 1 ] && front_is_bare && open_home
    boot_settings
}

cmd_status() {
    if [ -f "$OFF" ]; then
        echo "state: off (pear off, or a failed boot before this version; 'pear on' clears it)"
    elif [ "$(fail_count)" -ge "$MAX_FAILS" ]; then
        echo "state: on, but staying stock after $(fail_count) failed boots; 'pear on' retries"
    else
        echo "state: on"
    fi
    [ -f "$FAILED" ] && sed 's/^/  failed: /' "$FAILED"
    echo "home pid: $(home_pid)"
    echo "running: $(pear_id)  pear: $(cat "$STAMP" 2>/dev/null)"
    echo "context: $(context)"
    for f in $(pear_files); do
        mounted "$APP/$f" && echo "  mounted  $f" || echo "  -        $f"
    done
}

case "${1:-status}" in
    on) cmd_on ;;
    off) cmd_off ;;
    boot) cmd_boot ;;
    status) cmd_status ;;
    settings) boot_settings ;;
    unmount) umount_all ;;
    *) echo "usage: pearwebos on|off|boot|status|settings|unmount" >&2; exit 2 ;;
esac
