#!/bin/sh
# ambilightguard: give the LED strip back to WLED when the TV stops watching.
#
# HyperHDR streams to the WLED board over UDP and locks it "live" with no
# timeout (HyperHDR's WLED driver asks for that), so WLED's own return-to-
# effect timer never runs. HyperHDR releases the lock when it stops cleanly,
# but at power-off nothing stops it: the loader keys on the power state,
# which stays "Active" until the TV is already asleep, so HyperHDR dies
# mid-stream and the strip freezes on its last frame (black, usually).
# Even a clean stop is a race: HyperHDR's final UDP frame can land after
# its "live off" request, and the board stays locked.
#
# This watches the TV's power state. On "Request Power Off" it stops
# HyperHDR through the loader, waits for the process to go, then tells
# WLED to leave realtime mode and be on, so whatever the board's page has
# chosen shows. On the screensaver and on "Screen Off" the loader stops
# HyperHDR itself, so only the release is needed. On "Screen On" it asks the loader
# to start HyperHDR, which takes the board back: the loader restarts
# HyperHDR by itself only after stops it made on its own.
#
# Standalone: its own init.d hook, no PearWebOS dependency. Installed by
# `pear ambilight install`. $DIR/wled holds the board's address.
#
# Usage: ambilightguard start|stop|run|event '<power state json>'

DIR=${AMBILIGHTGUARD_DIR:-/var/lib/ambilightguard}
CONF=$DIR/wled
LOG=$DIR/ambilightguard.log
PID=$DIR/ambilightguard.pid
LOADER=luna://org.webosbrew.hyperhdr.loader.service
# how long to wait for HyperHDR to go away, in half seconds
WAIT=10

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"
    tail -n 200 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
}

poll_hyperhdr() {
    i=0
    while pidof hyperhdr >/dev/null 2>&1 && [ "$i" -lt "$WAIT" ]; do
        i=$((i + 1))
        usleep 500000
    done
    [ "$i" -lt "$WAIT" ]
}

# HyperHDR is gone; one that ignores the loader gets a TERM (never -9: it
# would leave its socket behind), because a release while it still streams
# is undone by its next frame
wait_hyperhdr_gone() {
    poll_hyperhdr && return 0
    log "HyperHDR still running after $((WAIT / 2)) s; terminating it"
    pkill -TERM -x hyperhdr 2>/dev/null
    poll_hyperhdr || log "HyperHDR did not exit"
}

# WLED: leave realtime mode and be on, so whatever the page chose shows
release_board() {
    [ -s "$CONF" ] || { log "$1, but no board address in $CONF; nothing sent"; return 1; }
    curl -s -m 2 -H 'Content-Type: application/json' -d '{"live":false,"on":true}' \
        "http://$(tr -d '\r\n' < "$CONF")/json/state" >/dev/null 2>&1 &&
        log "$1: board released to its effect" ||
        log "$1: the board did not answer"
}

# one line of the power state subscription
handle() {
    case "$1" in
        *'"Request Power Off"'*|*'"Request Active Standby"'*)
            luna-send -n 1 -w 3000 "$LOADER/stop" '{}' >/dev/null 2>&1
            wait_hyperhdr_gone
            release_board "power off" ;;
        *'"Screen Saver"'*|*'"Screen Off"'*)
            # the loader stops HyperHDR on these by itself
            wait_hyperhdr_gone
            release_board "screen saver or off" ;;
        *'"Screen On"'*)
            # the loader restarts HyperHDR after its own stops, not after ours
            luna-send -n 1 -w 3000 "$LOADER/start" '{}' >/dev/null 2>&1 &&
                log "screen on: HyperHDR started" ;;
    esac
}

case "${1:-run}" in
    event)
        handle "$2"
        exit 0 ;;
    stop)
        [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null
        rm -f "$PID"
        kill $(ps -eo pid,args | grep '[g]etPowerState.*subscribe' | awk '{print $1}') 2>/dev/null
        exit 0 ;;
    start)
        "$0" stop
        setsid "$0" run </dev/null >/dev/null 2>&1 &
        exit 0 ;;
esac

mkdir -p "$DIR"
echo $$ > "$PID"
log "started"
# the subscription ends if the bus restarts; follow it again
while :; do
    /usr/bin/luna-send -i luna://com.webos.service.tvpower/power/getPowerState '{"subscribe":true}' 2>/dev/null |
    while read -r line; do
        handle "$line"
    done
    sleep 5
done
